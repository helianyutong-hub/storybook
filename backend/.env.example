# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database: TCB PostgreSQL (auto-configured by genie-tcb-db-integrator skill)
# Do NOT set DATABASE_URL manually

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# 语音合成（TTS）
# 配置后使用阿里云百炼 CosyVoice，音色区分度最好（爷爷/奶奶是真实的老年人音色）。
# 不配置则免费回退到 Edge TTS（免费，但四个音色差异很小）。
# 获取 API Key：https://bailian.console.aliyun.com/?tab=model#/api-key
# DASHSCOPE_API_KEY=sk-xxxxxxxx
#
# 可选：百炼控制台的 WorkspaceId。配了会优先走 CosyVoice 专用端点（更稳定）。
# 不配也能用，会自动走标准 DashScope 端点。
# DASHSCOPE_WORKSPACE_ID=
#
# 可选：语音模型，默认 cosyvoice-v3-flash
# ALIYUN_TTS_MODEL=cosyvoice-v3-flash

# 可选：大模型故事生成（需求 1 完整情节 + 需求 4 动态页数）
# 不配置则前端自动回退到本地模板引擎（仍可正常用）。
# 兼容任意 OpenAI 格式接口：OpenAI / DeepSeek / 通义 / 智谱 等。
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
