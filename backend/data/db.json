  "stories": [
    {
      "id": "d0c4bdb5-2448-497e-ad71-e644925c4fe1",
      "userId": "682ac55e-1e36-4d64-879e-ad884885b264",
      "title": "朵朵的星空摇篮曲",
      "childName": "朵朵",
      "tone": "gentle",
      "bgSound": "music",
      "duration": "medium",
      "pageCount": 6,
      "createdAt": "2026-09-02T15:31:49.723Z",
      "approved": false,
      "data": {
        "id": "d0c4bdb5-2448-497e-ad71-e644925c4fe1",
        "title": "朵朵的星空摇篮曲",
        "params": {
          "childName": "朵朵",
          "tone": "gentle",
          "bgSound": "music",
          "duration": "medium",
          "characters": [
            "小熊"
          ],
          "pace": "slow",
          "volume": 0.8,
          "soothing": 70
        },
        "pages": [
          {
            "id": "p0-7683",
            "text": "夜晚到了，朵朵揉了揉眼睛。窗外的树影慢慢安静下来。",
            "scene": "夜幕降临，孩子准备入睡",
            "illustration": {
              "seed": 53755,
              "palette": "night",
              "elements": [
                "moon",
                "stars",
                "window"
              ],
              "mood": "gentle",
              "hasChild": false
            }
          },
          {
            "id": "p1-7747",
            "text": "小熊悄悄说：“别怕，我陪朵朵一起。”",
            "scene": "小熊来到孩子身边陪伴",
            "illustration": {
              "seed": 600948,
              "palette": "night",
              "elements": [
                "friend",
                "stars"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p2-5173",
            "text": "温柔的云朵飘过来，朵朵和小熊坐上去轻轻摇。",
            "scene": "孩子与角色一起做安静的小游戏",
            "illustration": {
              "seed": 894625,
              "palette": "dream",
              "elements": [
                "cloud",
                "friend"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p3-1141",
            "text": "暖暖的云朵飘过来，朵朵和小熊坐上去轻轻摇。",
            "scene": "孩子与角色一起做安静的小游戏",
            "illustration": {
              "seed": 520095,
              "palette": "dream",
              "elements": [
                "stars",
                "friend"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p4-7374",
            "text": "朵朵打了个大大的哈欠，暖暖的困意悄悄来了。",
            "scene": "困意袭来，慢慢放松",
            "illustration": {
              "seed": 519676,
              "palette": "cozy",
              "elements": [
                "bed",
                "moon"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p5-1096",
            "text": "呼吸变得长长的，朵朵进入了甜甜的梦乡。晚安。",
            "scene": "安然入睡，进入梦乡",
            "illustration": {
              "seed": 949999,
              "palette": "cozy",
              "elements": [
                "bed",
                "moon",
                "stars"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          }
        ],
        "createdAt": "2026-09-02T15:31:49.723Z",
        "approved": false
      }
    },
    {
      "id": "631a5023-aa1c-4e15-975d-4431697c9e7d",
      "userId": "682ac55e-1e36-4d64-879e-ad884885b264",
      "title": "朵朵和小熊的晚安时光",
      "childName": "朵朵",
      "tone": "gentle",
      "bgSound": "music",
      "duration": "long",
      "pageCount": 8,
      "createdAt": "2026-09-02T15:49:57.897Z",
      "approved": false,
      "data": {
        "id": "631a5023-aa1c-4e15-975d-4431697c9e7d",
        "title": "朵朵和小熊的晚安时光",
        "params": {
          "childName": "朵朵",
          "tone": "gentle",
          "bgSound": "music",
          "duration": "long",
          "characters": [
            "小熊"
          ],
          "pace": "slow",
          "volume": 0.8,
          "soothing": 100
        },
        "pages": [
          {
            "id": "p0-2536",
            "text": "夜晚到了，朵朵揉了揉眼睛。软绵绵的小床慢慢安静下来。",
            "scene": "夜幕降临，孩子准备入睡",
            "illustration": {
              "seed": 359816,
              "palette": "night",
              "elements": [
                "moon",
                "stars",
                "window"
              ],
              "mood": "gentle",
              "hasChild": false
            }
          },
          {
            "id": "p1-1875",
            "text": "朵朵看见小熊，慢慢晃着，心里甜甜的。",
            "scene": "小熊来到孩子身边陪伴",
            "illustration": {
              "seed": 465128,
              "palette": "night",
              "elements": [
                "friend",
                "stars"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p2-5835",
            "text": "小熊讲了个温柔的小秘密，朵朵咯咯地笑。",
            "scene": "孩子与角色一起做安静的小游戏",
            "illustration": {
              "seed": 55375,
              "palette": "night",
              "elements": [
                "stars"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p3-3899",
            "text": "小熊讲了个软软的小秘密，朵朵咯咯地笑。",
            "scene": "孩子与角色一起做安静的小游戏",
            "illustration": {
              "seed": 624698,
              "palette": "dream",
              "elements": [
                "stars"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p4-5787",
            "text": "小河依偎着，朵朵和小熊听得好开心。",
            "scene": "孩子与角色一起做安静的小游戏",
            "illustration": {
              "seed": 653920,
              "palette": "dream",
              "elements": [
                "stars",
                "friend"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p5-1180",
            "text": "小河悄悄看着，朵朵和小熊听得好开心。",
            "scene": "孩子与角色一起做安静的小游戏",
            "illustration": {
              "seed": 609113,
              "palette": "cozy",
              "elements": [
                "river"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p6-5386",
            "text": "小熊轻轻拍着朵朵的背，一下，又一下。",
            "scene": "困意袭来，慢慢放松",
            "illustration": {
              "seed": 487740,
              "palette": "cozy",
              "elements": [
                "bed",
                "moon"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p7-6283",
            "text": "朵朵睡着啦，梦里开满了轻轻的小花。晚安，朵朵。",
            "scene": "安然入睡，进入梦乡",
            "illustration": {
              "seed": 315835,
              "palette": "cozy",
              "elements": [
                "bed",
                "moon",
                "stars",
                "friend"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          }
        ],
        "createdAt": "2026-09-02T15:49:57.897Z",
        "approved": false
      }
    },
