    {
      "id": "d81d1d0a-a258-41bf-b02a-5571f1aa42d2",
      "userId": "1d80aa40-2f9d-4655-a9ad-5188c8b56339",
      "title": "宝宝的月亮小船",
      "childName": "",
      "tone": "gentle",
      "bgSound": "rain",
      "duration": "long",
      "pageCount": 19,
      "createdAt": "2026-09-03T07:35:16.510Z",
      "approved": false,
      "data": {
        "id": "d81d1d0a-a258-41bf-b02a-5571f1aa42d2",
        "title": "宝宝的月亮小船",
        "params": {
          "childName": "",
          "tone": "gentle",
          "bgSound": "rain",
          "duration": "long",
          "characters": [
            "小狐狸",
            "小鸭子"
          ],
          "pace": "slow",
          "volume": 0.8,
          "soothing": 100,
          "lang": "zh",
          "voice": "mommy"
        },
        "pages": [
          {
            "id": "p0-7405",
            "text": "星星一颗接一颗亮起来，像有人在天边点起了小灯笼。宝宝钻进软软的被窝，心里却还醒着，像在等一件温柔的事发生。",
            "scene": "夜幕降临，孩子准备入睡",
            "illustration": {
              "seed": 342462,
              "palette": "night",
              "elements": [
                "moon",
                "stars",
                "window"
              ],
              "mood": "gentle",
              "hasChild": false
            }
          },
          {
            "id": "p1-9656",
            "text": "小鸭子从窗边飘来，带着一点点月光的气息。它歪着头看宝宝，眼里满是温柔：“今晚睡不着吧？那我们去做件温柔的事。”",
            "scene": "角色拍拍枕头，温柔靠近",
            "illustration": {
              "seed": 133098,
              "palette": "night",
              "elements": [
                "friend",
                "stars"
              ],
              "mood": "gentle",
              "hasChild": true
            }
          },
          {
            "id": "p2-8819",
            "text": "到了风婆婆的摇篮边，宝宝一眼就看见了想学会发光的小萤火虫妹妹——它正安安静静地待着，好像早就知道宝宝和小狐狸会来。",
            "scene": "顺着指引看见孤单的小任务",
            "illustration": {
              "seed": 499080,
              "palette": "night",
              "elements": [
                "cloud"
              ],
